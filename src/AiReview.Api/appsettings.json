{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiReview": {
    "Provider": "bedrock",
    "MaxAttempts": 2,
    "Bedrock": {
      "ModelId": "us.anthropic.claude-sonnet-4-6",
      "Region": "us-east-1",
      "TimeoutSeconds": 30,
      "MaxTokens": 1500,
      "Temperature": 0
    },
    "Confidence": {
      "ExtractionWeight": 0.5,
      "RuleMatchWeight": 0.5,
      "WeakestFieldMargin": 0.10,
      "HighThreshold": 0.85,
      "MediumThreshold": 0.65
    }
  }
}
