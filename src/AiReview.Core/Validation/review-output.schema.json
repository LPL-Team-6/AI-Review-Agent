{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "key_concerns", "recommended_next_steps", "draft_case_note"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "key_concerns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concern", "cited_finding_ids"],
        "properties": {
          "concern": { "type": "string", "minLength": 1, "maxLength": 300 },
          "cited_finding_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "draft_case_note": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
